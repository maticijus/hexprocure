# Copy to .env.local and fill in. NEVER commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procurelite_dev
# Session secret, required, min 32 chars, placeholders rejected at startup.
# Generate with: openssl rand -hex 32
AUTH_SECRET=
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_OCR_URL=
SMTP_URL=
SMTP_FROM=hexprocure@yourcompany.com
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_SANDBOX=true
INTEGRATION_REDIRECT_URI=
INTEGRATION_ENC_KEY=
# Optional: LLM line-item extraction. When set, OCR text and PO lines are sent to the Anthropic API.
ANTHROPIC_API_KEY=
INTEGRATION_LLM_MODEL=claude-opus-5-5

# Optional paid-tier licence (offline, Ed25519 signed). Unset means Community.
HEXPROCURE_LICENSE=
# PEM public key that verifies HEXPROCURE_LICENSE (use \n for newlines in one-line env files)
HEXPROCURE_LICENSE_PUBLIC_KEY=

# Self-registration (POST /api/v1/auth/register, always creates REQUESTER).
# Open by default in development; in production it must be exactly "true".
ALLOW_SELF_REGISTRATION=
# Set to "true" only behind a reverse proxy that appends the real client IP as the
# last X-Forwarded-For hop. Otherwise rate limits key on X-Real-IP or one shared bucket.
TRUST_PROXY=
